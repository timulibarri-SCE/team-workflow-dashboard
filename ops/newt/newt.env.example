# Copy this file to ops/newt/.env on the ABM Lion BMS Linux host.
# Do not commit the real .env file.

# Pangolin site connector details from the Pangolin dashboard.
PANGOLIN_ENDPOINT=https://REPLACE_WITH_PANGOLIN_ENDPOINT
NEWT_ID=REPLACE_WITH_NEWT_SITE_ID
NEWT_SECRET=REPLACE_WITH_NEWT_SITE_SECRET

# Keep the connector name operational and non-sensitive.
NEWT_NAME=lion-hopvac-abm-bms
