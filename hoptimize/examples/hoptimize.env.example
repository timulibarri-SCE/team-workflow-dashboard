# Copy to /etc/hoptimize/hoptimize.env and set mode 0640.

HOPTIMIZE_APP_NAME=Hoptimize
HOPTIMIZE_HOST=127.0.0.1
HOPTIMIZE_PORT=8090
HOPTIMIZE_DB_PATH=/var/lib/hoptimize/audit.sqlite3

# First release auth: local JWT validation using HS256.
# Generate with:
#   openssl rand -base64 48
# For Authentik/OIDC, keep the API behind Authentik or extend auth.py to use JWKS.
HOPTIMIZE_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
HOPTIMIZE_JWT_ALGORITHM=HS256
HOPTIMIZE_JWT_ISSUER=
HOPTIMIZE_JWT_AUDIENCE=
HOPTIMIZE_JWT_ROLE_CLAIM=role

HOPTIMIZE_ALLOWED_SERVICES=frpc,bms-api,fuxa,nginx,traefik,docker,hoptimize
HOPTIMIZE_ALLOWED_CONTAINERS=frpc,bms-api,fuxa,nginx,traefik,hoptimize
HOPTIMIZE_ALLOWED_COMPOSE_STACKS=

HOPTIMIZE_LOG_LINE_VALUES=50,100,200,500
HOPTIMIZE_LOG_SUMMARY_CHARS=2000
HOPTIMIZE_COMMAND_TIMEOUT_SECONDS=30

HOPTIMIZE_USE_SUDO=true
HOPTIMIZE_SUDO_PATH=/usr/bin/sudo
HOPTIMIZE_SYSTEMCTL_PATH=/usr/bin/systemctl
HOPTIMIZE_JOURNALCTL_PATH=/usr/bin/journalctl
